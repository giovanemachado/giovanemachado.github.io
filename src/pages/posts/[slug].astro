---
import BaseLayout from '../../components/BaseLayout.astro';
import PostView from '../../components/PostView.astro';
import { posts, type Post } from '../../data/posts';
import type { Lang } from '../../i18n';

export function getStaticPaths() {
    return posts
        .filter((post) => !post.archive)
        .map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
    post: Post;
}

const lang: Lang = 'pt-br';
const { post } = Astro.props;
---

<BaseLayout lang={lang} title={`${post.title[lang]} - giovane machado`} altHref={`/en/posts/${post.slug}/`}>
    <PostView post={post} lang={lang} />
</BaseLayout>
