---
import BaseLayout from '@/components/BaseLayout.astro';
import PostView from '@/components/PostView.astro';
import { itemsFor } from '@/data/lists';
import type { Lang } from '@/i18n';
import { postsFor } from '@/lib/posts';
import { render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
    return (await postsFor('en-us')).map(({ slug, entry }) => ({
        params: { slug },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'posts'>;
}

const lang: Lang = 'en-us';
const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.split('/')[0];
---

<BaseLayout lang={lang} title={`${entry.data.title} - giovane machado`} altHref={`/posts/${slug}/`}>
    <PostView title={entry.data.title} date={entry.data.date} items={itemsFor(slug) ?? entry.data.items} embed={entry.data.embed} lang={lang}>
        <Content />
    </PostView>
</BaseLayout>
