---
import type { Lang } from '../i18n';
import type { Post } from '../data/posts';
import { sortByStars } from '../data/posts';
import StarList from './StarList.astro';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const bodyHtml = post.body?.[lang] ?? post.body?.['pt-br'] ?? '';
const items = sortByStars(post.items ?? []);
---

<div>
    <h2 class="text-xl font-bold">{post.title[lang]}</h2>
    <p class="opacity-70">{post.date}</p>
    <br />
    <p>{post.intro[lang]}</p>
    {bodyHtml && (
        <>
            <br />
            <div set:html={bodyHtml} />
        </>
    )}
    {items.length > 0 && (
        <>
            <br />
            <StarList items={items} lang={lang} />
        </>
    )}
</div>
