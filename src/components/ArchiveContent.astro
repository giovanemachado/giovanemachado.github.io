---
import { archivePost, recentPosts } from '../data/posts';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const archive = archivePost();
const rows = recentPosts.filter((post) => !post.archive);
const postHref = (slug: string) => `${lang === 'en-us' ? '/en' : ''}/posts/${slug}/`;
---

<div>
    <h2 class="text-xl font-bold">{archive.title[lang]}</h2>
    <p class="opacity-70">{archive.date}</p>
    <br />
    <p>{archive.intro[lang]}</p>
    <br />
    <ul>
        {rows.map((post) => (
            <li>* <a class="underline" href={postHref(post.slug)}>{post.title[lang]} ({post.date})</a></li>
        ))}
    </ul>
</div>
