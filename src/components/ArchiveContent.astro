---
import { archive } from '../data/archive';
import { postPath, recentPostsFor } from '../lib/posts';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const rows = await recentPostsFor(lang);
---

<div>
    <h2 class="text-xl font-bold">{archive.title[lang]}</h2>
    <p class="opacity-70">{archive.date}</p>
    <br />
    <p>{archive.intro[lang]}</p>
    <br />
    <ul>
        {rows.map((post) => (
            <li>* <a class="underline" href={postPath(lang, post.slug)}>{post.entry.data.title} ({post.entry.data.date})</a></li>
        ))}
    </ul>
</div>
